{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TURBODOS",
  "version": "0.3.0",
  "identifier": "com.dosdeck.app",
  "build": {
    "beforeDevCommand": "npm run dev:vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:vite",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "TURBODOS",
        "width": 1100,
        "height": 720,
        "minWidth": 800,
        "minHeight": 540,
        "resizable": true,
        "decorations": false,
        "fullscreen": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "dosbox/*": "dosbox/"
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:dosdeck.db"]
    }
  }
}
